# LegalMinds - Environment Configuration Template
# Copy this file to .env and fill in your API keys

# ---- REQUIRED FOR AI FEATURES ----
# Google Gemini API Key (Get your free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- OPTIONAL ENHANCEMENTS ----
# Google Cloud Translation API Key (Optional)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# Google Cloud Text-to-Speech Credentials Path (Optional)
GOOGLE_TTS_CREDENTIALS=path/to/credentials.json

# ---- FLASK SERVER CONFIGURATION ----
FLASK_SECRET_KEY=dev-secret-key-change-in-production
FLASK_DEBUG=True
MAX_UPLOAD_SIZE_MB=20
